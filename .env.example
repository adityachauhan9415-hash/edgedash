# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.
# .env.example IS committed — it documents which keys are expected.

# Apify API token — required for the "apify" source.
# Get yours at https://console.apify.com/account/integrations
APIFY_TOKEN=

# Apify actor to use for job scraping (default: misceres/indeed-scraper)
# APIFY_ACTOR_ID=misceres/indeed-scraper

# ── LLM provider ───────────────────────────────────────────────────────────
# EDGEDASH_LLM_PROVIDER=gemini        # "gemini" (default) or "ollama"
# EDGEDASH_LLM_MODEL=gemini-2.0-flash # model name passed to the provider

# Google Gemini API key — required when EDGEDASH_LLM_PROVIDER=gemini
# Free tier: 15 RPM on gemini-2.0-flash
# Get yours at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Ollama local server — required when EDGEDASH_LLM_PROVIDER=ollama
# Run `ollama serve` and `ollama pull llama3` first; no API key needed.
# OLLAMA_BASE_URL=http://localhost:11434

# Rate limits (default: free-tier safe for Gemini)
# EDGEDASH_LLM_RPM=15
# EDGEDASH_LLM_RPS=1.0
# EDGEDASH_SCORING_BATCH=25

# ── Pipeline overrides ─────────────────────────────────────────────────────
# EDGEDASH_TARGET_ROLE=Data Engineer
# EDGEDASH_CITY=San Francisco, CA
# EDGEDASH_SOURCES=arbeitnow,apify
# EDGEDASH_USE_MOCK=0
# EDGEDASH_DB_PATH=edgedash.db
